// Prisma schema para Sistema-Taller (Ventas + Stock)
// Ver Documentation/03-modelo-de-datos.md para el detalle conceptual.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id_categoria Int     @id @default(autoincrement())
  nombre       String  @unique
  descripcion  String?

  items Item[]

  @@map("categorias")
}

enum TipoVehiculo {
  MOTO
  AUTO
}

model Item {
  id_item       Int           @id @default(autoincrement())
  id_categoria  Int
  nombre        String
  descripcion   String?
  imagen_url    String?
  precio_base   Decimal?      @db.Decimal(10, 2)
  stock_actual  Int?
  tipo_vehiculo TipoVehiculo?
  activo        Boolean       @default(true)

  categoria     Categoria      @relation(fields: [id_categoria], references: [id_categoria])
  detalle_venta DetalleVenta[]

  @@map("items")
}

model MetodoPago {
  id_metodo_pago Int     @id @default(autoincrement())
  nombre         String  @unique
  activo         Boolean @default(true)

  ventas Venta[]

  @@map("metodos_pago")
}

model Venta {
  id_venta       Int      @id @default(autoincrement())
  id_metodo_pago Int
  monto_total    Decimal  @db.Decimal(10, 2)
  fecha_hora     DateTime @default(now())
  observaciones  String?

  metodo_pago MetodoPago     @relation(fields: [id_metodo_pago], references: [id_metodo_pago])
  detalles    DetalleVenta[]

  @@index([fecha_hora])
  @@map("ventas")
}

enum Rueda {
  DELANTERA
  TRASERA
}

enum Lado {
  DERECHA
  IZQUIERDA
}

// Agrupa uno o más servicios cargados en una misma venta bajo un mismo
// vehículo atendido. Se crea junto con la venta (no es un catálogo
// reutilizable entre visitas) — ver Documentation/03-modelo-de-datos.md.
model Vehiculo {
  id_vehiculo   Int          @id @default(autoincrement())
  patente       String?
  tipo_vehiculo TipoVehiculo
  creado_en     DateTime     @default(now())

  detalles DetalleVenta[]

  @@index([patente])
  @@map("vehiculos")
}

model DetalleVenta {
  id_detalle      Int     @id @default(autoincrement())
  id_venta        Int
  id_item         Int
  id_vehiculo     Int?
  cantidad        Int
  precio_unitario Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)
  descripcion     String?
  rueda           Rueda?
  lado            Lado?

  venta    Venta     @relation(fields: [id_venta], references: [id_venta])
  item     Item      @relation(fields: [id_item], references: [id_item])
  vehiculo Vehiculo? @relation(fields: [id_vehiculo], references: [id_vehiculo])

  @@index([id_vehiculo])
  @@map("detalles_venta")
}
